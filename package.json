{
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm-run-all --parallel serve:backend serve:web serve:frontend",
    "serve:backend": "php artisan serve",
    "serve:web": "vite --port=3001",
    "serve:frontend": "cd backend && npm run dev",
    "build": "vite build",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@alpinejs/collapse": "^3.13.7",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.7",
    "alpinejs": "^3.13.7",
    "autoprefixer": "^10.4.19",
    "axios": "^1.6.8",
    "laravel-vite-plugin": "^1.0",
    "lodash": "^4.17.21",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "vite": "^5.2.4"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.6.0"
  }
}
